{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__OPERATOR_SUPPLIED_WORKER__",
  "account_id": "__OPERATOR_SUPPLIED_ACCOUNT_ID__",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOW_LOCAL_AUTH": "false",
    "ACCESS_TEAM_DOMAIN": "__OPERATOR_SUPPLIED_ACCESS_TEAM_DOMAIN__",
    "ACCESS_AUD": "__OPERATOR_SUPPLIED_ACCESS_AUDIENCE__",
    "LOCAL_AUTH_SECRET": "unset",
    "LOCAL_ACTOR_IDENTITY": "unset",
    "BACKUP_ACTOR_ID": "__OPERATOR_SUPPLIED_BACKUP_ACTOR_ID__",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__OPERATOR_SUPPLIED_D1_DATABASE__",
      "database_id": "__OPERATOR_SUPPLIED_D1_DATABASE_ID__",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS_BUCKET",
      "bucket_name": "__OPERATOR_SUPPLIED_R2_BUCKET__",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "__OPERATOR_SUPPLIED_EVENT_QUEUE__",
      },
    ],
    "consumers": [
      {
        "queue": "__OPERATOR_SUPPLIED_EVENT_QUEUE__",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        // Five Queue retries allow six consumer deliveries: five export claims and one stale-lease recovery.
        "max_retries": 5,
        "visibility_timeout_ms": 300000,
        "dead_letter_queue": "__OPERATOR_SUPPLIED_EVENT_QUEUE_DLQ__",
        "retry_delay": 300,
      },
    ],
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": false,
    },
    "traces": {
      "enabled": false,
      "persist": false,
    },
  },
}
