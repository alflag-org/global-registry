{
  "name": "global-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure inventory and IP address management on Cloudflare Workers and D1.",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --env development --ip 127.0.0.1",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "browser:install": "playwright install chromium",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "pnpm check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env development",
    "deploy:dry-run:local": "wrangler deploy --dry-run --env development",
    "smoke:local": "pnpm db:migrate:local && pnpm test:browser"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.13.8",
    "ipaddr.js": "2.5.0",
    "jose": "^6.2.12",
    "swagger-ui-dist": "5.32.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.118.0"
  }
}
