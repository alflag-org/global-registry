{
  "name": "global-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure inventory and IP address management on Cloudflare Workers and D1.",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "check": "pnpm types && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "pnpm types && pnpm typecheck",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:dry-run:local": "wrangler deploy --dry-run",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.11",
    "ipaddr.js": "2.5.0",
    "swagger-ui-dist": "5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
